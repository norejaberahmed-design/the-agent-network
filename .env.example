# Local PostgreSQL connection. Never commit real credentials.
DATABASE_URL="postgresql://tan:tan_local_only@localhost:5432/the_agent_network?schema=public"

# Generate a unique random secret before running any shared environment.
BETTER_AUTH_SECRET="replace-with-at-least-32-random-bytes"
BETTER_AUTH_URL="http://localhost:3000"

# Keep false until email delivery and verification are configured.
# Invitation redemption is the only supported account creation path.
APP_PUBLIC_SIGNUP_ENABLED="false"

NEXT_PUBLIC_BETTER_AUTH_URL="http://localhost:3000"

# One-time first-admin bootstrap only. Remove these from the runtime after bootstrap.
TAN_BOOTSTRAP_ADMIN_EMAIL=""
TAN_BOOTSTRAP_ADMIN_PASSWORD=""
TAN_BOOTSTRAP_ADMIN_NAME="Platform Administrator"
TAN_BOOTSTRAP_TOKEN=""

# Optional AI planning worker. Leave empty to keep provider execution disabled.
# Configure only after reviewing data processing, provider spend limits, and consent settings.
OPENAI_API_KEY=""
OPENAI_AGENT_MODEL=""
OPENAI_AGENT_MAX_DAILY_RUNS="20"

# Long random secret for the internal worker endpoint; keep server-side only.
AGENT_WORKER_SECRET=""
